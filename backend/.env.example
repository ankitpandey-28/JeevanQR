# QR Emergency Alert System - Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server port (default: 3000 to match original Node.js backend)
PORT=3000

# Allowed CORS origin (optional - restrict to specific domain)
# Example: ALLOWED_ORIGIN=https://example.com
# Leave empty to allow all origins (development)
ALLOWED_ORIGIN=

# Site URL for QR code generation (optional)
# Used to build absolute URLs embedded in QR codes.
# Priority: SITE_URL > VERCEL_URL > request host > localhost:3000
SITE_URL=

# Vercel deployment URL (auto-set by Vercel in production)
VERCEL_URL=

# Environment mode
NODE_ENV=development